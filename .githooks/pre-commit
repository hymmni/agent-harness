#!/bin/sh
# main 직접 커밋과 규칙에 맞지 않는 브랜치 이름을 막는다.
git rev-parse -q --verify HEAD >/dev/null || exit 0     # 레포의 첫 커밋
branch=$(git symbolic-ref -q --short HEAD) || exit 0    # detached HEAD

if [ "$branch" = main ]; then
  echo "BLOCKED: main에 직접 커밋하거나 병합할 수 없습니다. 브랜치를 만들어 PR로 합치세요." >&2
  exit 1
fi

if ! printf '%s\n' "$branch" | LC_ALL=C grep -Eq '^(feat|fix|hotfix|refactor|docs|chore)/[a-z0-9._-]+$'; then
  echo "BLOCKED: 브랜치 이름 '$branch'이(가) 규칙에 맞지 않습니다." >&2
  echo "  형식: feat|fix|hotfix|refactor|docs|chore/<소문자 주제>" >&2
  exit 1
fi
